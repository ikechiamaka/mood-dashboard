# Set these in DigitalOcean App Platform, not in a committed secrets file.
APP_ENV=production
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=verify-full&sslrootcert=/workspace/certs/database-ca.crt
REQUIRE_POSTGRES=1
SEED_DEMO_DATA=0
SIMULATE_VITALS=0
CHATBOT_PROVIDER=local
CHATBOT_LOCAL_ONLY=1
CHATBOT_NO_PHI=1
SHOW_ROLE_SWITCHER=0
# Enable only after the single-process pilot and alert delivery have been tested.
ENABLE_ALERT_MONITOR=0
DISABLE_ALERT_MONITOR=1
