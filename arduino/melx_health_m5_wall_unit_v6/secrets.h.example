#pragma once

// Wi-Fi credentials
#define WIFI_SSID       "YOUR_2_4GHZ_WIFI_NAME"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// Flask backend base URL.
// Use the final HTTPS app hostname and verify the matching CA in tls_ca.h.
#define SERVER_BASE_URL "https://www.melxhealth.com"

// Device bearer API key from the MelX Health admin/device setup.
// This must match the wall_unit device record configured on the backend.
#define WALL_API_KEY    "PASTE_DEVICE_API_KEY_HERE"

// These must match the device record and bed assignment in the dashboard.
#define WALL_DEVICE_ID  "WALL-001"
#define FACILITY_ID     "1"
#define BED_ID          "PASTE_ACTUAL_BED_ID"

// Timezone: Nigeria/WAT is UTC+1 with no daylight-saving time.
#define TZ_INFO         "WAT-1"

// Firmware label sent in the payload raw data.
#define WALL_UI_VERSION "tab5_wall_unit_v6"
